PORT=3000
SESSION_SECRET=zmien-to-na-losowy-sekret
# Opcja 1: pełny URL LDAP/LDAPS (ma pierwszeństwo nad AD_PROTOCOL/AD_HOST/AD_PORT)
AD_URL=
# Opcja 2: składanie URL z pól poniżej
AD_PROTOCOL=ldaps
AD_HOST=dc01.hospital.local
AD_PORT=636
# Dla ldap:// możesz włączyć StartTLS (true/false)
AD_TLS_ENABLED=true
AD_BASE_DN=DC=hospital,DC=local
AD_BIND_DN=CN=svc_adportal,OU=Service,DC=hospital,DC=local
AD_BIND_PASSWORD=SuperSecretPassword
# false = wszystkie operacje AD na koncie serwisowym; true = operacje AD na koncie zalogowanego użytkownika
AD_USE_LOGGED_USER_BIND=false
AD_ALLOWED_GROUP_DN=CN=AD-Portal-Admins,OU=Groups,DC=hospital,DC=local
AD_ALLOWED_USERS=user1,user2
AD_TLS_REJECT_UNAUTHORIZED=true
AD_DEBUG=false

# --- SCCM (Microsoft Configuration Manager) ---
# URL bazowy endpointu AdminService (WMI) Twojej witryny SCCM.
SCCM_URL=https://sccm01.hospital.local/AdminService/wmi
# Uwierzytelnianie SCCM używa tego samego konta AD co LDAP, ale NTLM
# wymaga zwykłej nazwy użytkownika (sAMAccountName) + domeny, a nie DN/UPN:
# - gdy AD_USE_LOGGED_USER_BIND=true: użyty zostanie login i hasło aktualnie
#   zalogowanego użytkownika portalu (bez dodatkowej konfiguracji),
# - gdy AD_USE_LOGGED_USER_BIND=false: podaj poniżej sAMAccountName konta
#   serwisowego z AD_BIND_DN (hasło to nadal AD_BIND_PASSWORD).
SCCM_SERVICE_USERNAME=svc_adportal
# Domena NTLM (NetBIOS lub DNS). Domyślnie wyliczana z AD_BASE_DN.
SCCM_DOMAIN=
SCCM_TLS_REJECT_UNAUTHORIZED=true
# Tryb uwierzytelniania: "ntlm" (domyślny) albo "kerberos" - użyj "kerberos",
# gdy IIS dla AdminService oferuje tylko Negotiate (brak dostawcy NTLM).
# Wymaga zainstalowanego "kinit" (pakiet krb5-user/krb5-workstation) oraz
# modułu npm "kerberos" (biblioteki krb5-dev przy instalacji). Zobacz sekcję
# SCCM w README.md.
SCCM_AUTH_MODE=ntlm
# Realm Kerberos (zwykle domena wielkimi literami). Domyślnie wyliczany z AD_BASE_DN.
SCCM_KERBEROS_REALM=
# Service Principal Name serwera AdminService. Domyślnie "HTTP@<host z SCCM_URL>".
SCCM_SPN=
