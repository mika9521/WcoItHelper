<div class="modal fade" id="objectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon" id="objectTitleIcon"><svg class="icon"><use href="#i-info"/></svg></span>
          <div>
            <h5 class="modal-title" id="objectTitle">Szczegóły obiektu</h5>
            <div class="modal-subtitle" id="objectSubtitle"></div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="objectBody"></div>
      <div class="modal-footer">
        <div class="me-auto small text-muted" id="pendingChangesInfo"></div>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zamknij</button>
        <button type="button" class="btn btn-primary d-none" id="applyObjectChangesBtn">Zastosuj zmiany</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="softDeleteConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon modal-title-icon-danger"><svg class="icon"><use href="#i-lock"/></svg></span>
          <div>
            <h5 class="modal-title">Zablokuj konto</h5>
            <div class="modal-subtitle">Soft delete</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="dn-box mb-3" id="softDeleteTargetDn">-</div>
        <p class="mb-2">Po potwierdzeniu konto zostanie:</p>
        <ul class="mb-2">
          <li>wyłączone,</li>
          <li>przeniesione do OU <code>zablokowane_konta</code>.</li>
        </ul>
        <div class="small text-muted">Operację można cofnąć przyciskiem <strong>Odblokuj</strong> w wynikach wyszukiwania.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
        <button type="button" class="btn btn-danger" id="confirmSoftDeleteBtn">Zablokuj konto</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="softDeleteSuccessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon modal-title-icon-success"><svg class="icon"><use href="#i-check"/></svg></span>
          <h5 class="modal-title">Konto zablokowane</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Konto zostało wyłączone i przeniesione do OU <code>zablokowane_konta</code>.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="unlockAccountModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon modal-title-icon-success"><svg class="icon"><use href="#i-unlock"/></svg></span>
          <div>
            <h5 class="modal-title">Odblokuj konto</h5>
            <div class="modal-subtitle">Włączenie i przeniesienie z OU zablokowane_konta</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="dn-box mb-3" id="unlockTargetDnLabel">-</div>
        <label class="form-label">Docelowe OU po odblokowaniu <span class="text-danger">*</span></label>
        <div class="ou-field" data-target-input="unlockTargetOuDn">
          <input type="hidden" id="unlockTargetOuDn" />
          <button type="button" class="ou-field-btn pick-ou-btn" data-target-input="unlockTargetOuDn">
            <svg class="icon"><use href="#i-folder"/></svg>
            <span class="ou-field-text" data-placeholder="Wybierz jednostkę organizacyjną…">Wybierz jednostkę organizacyjną…</span>
            <svg class="icon ou-field-caret"><use href="#i-chevron-down"/></svg>
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
        <button type="button" class="btn btn-success" id="confirmUnlockBtn">Odblokuj konto</button>
      </div>
    </div>
  </div>
</div>
