<div class="modal fade" id="newUserModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <form id="newUserForm" class="modal-content" autocomplete="off" novalidate>
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon"><svg class="icon"><use href="#i-user-plus"/></svg></span>
          <div>
            <h5 class="modal-title">Nowy użytkownik</h5>
            <div class="modal-subtitle">Utwórz konto w Active Directory</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <ol class="wizard-steps" id="newUserSteps">
        <li class="wizard-step active" data-step="1"><span class="wizard-step-num">1</span><span class="wizard-step-label">Typ użytkownika</span></li>
        <li class="wizard-step" data-step="2"><span class="wizard-step-num">2</span><span class="wizard-step-label">Informacje o użytkowniku</span></li>
        <li class="wizard-step" data-step="3"><span class="wizard-step-num">3</span><span class="wizard-step-label">Uprawnienia</span></li>
        <li class="wizard-step" data-step="4"><span class="wizard-step-num">4</span><span class="wizard-step-label">Udziały sieciowe</span></li>
        <li class="wizard-step" data-step="5"><span class="wizard-step-num">5</span><span class="wizard-step-label">Inne grupy</span></li>
        <li class="wizard-step" data-step="6"><span class="wizard-step-num">6</span><span class="wizard-step-label">Podsumowanie</span></li>
      </ol>

      <div class="modal-body">
        <!-- Krok 1: typ użytkownika -->
        <div class="wizard-pane" data-pane="1">
          <div class="text-center mb-4">
            <div class="fw-semibold fs-5">Jakiego użytkownika chcesz utworzyć?</div>
            <div class="text-muted small">Wybierz typ konta, a następnie kliknij „Informacje o użytkowniku”.</div>
          </div>
          <div class="user-type-grid" role="radiogroup" aria-label="Typ użytkownika">
            <label class="user-type-card">
              <input type="radio" name="userType" value="eskulap-domain" class="user-type-input">
              <span class="user-type-icon"><svg class="icon"><use href="#i-user"/></svg></span>
              <span class="user-type-title">Użytkownik domeny Eskulap</span>
              <span class="user-type-desc">Standardowe konto domenowe: logowanie do komputerów, poczta i zasoby sieciowe zgodnie z uprawnieniami.</span>
              <span class="user-type-check"><svg class="icon"><use href="#i-check"/></svg></span>
            </label>
            <label class="user-type-card">
              <input type="radio" name="userType" value="service" class="user-type-input">
              <span class="user-type-icon user-type-icon-service"><svg class="icon"><use href="#i-settings"/></svg></span>
              <span class="user-type-title">Konto serwisowe</span>
              <span class="user-type-desc">Konto dla aplikacji lub usługi. Login w formacie <code>svc_nazwa</code>, tworzone zawsze w OU kont serwisowych z Ustawień.</span>
              <span class="user-type-check"><svg class="icon"><use href="#i-check"/></svg></span>
            </label>
          </div>
        </div>

        <!-- Krok 2: informacje o użytkowniku -->
        <div class="wizard-pane d-none" data-pane="2">
        <!-- Użytkownik wzorcowy -->
        <div class="reference-bar" id="newUserReferenceBar">
          <div class="reference-empty" id="newUserReferenceEmpty">
            <span class="reference-icon"><svg class="icon"><use href="#i-copy"/></svg></span>
            <div class="flex-grow-1">
              <div class="fw-semibold">Utwórz na wzór istniejącego konta</div>
              <div class="small text-muted">Wybierz użytkownika wzorcowego, aby skopiować jego OU. W kroku uprawnień możesz zaznaczyć te same uprawnienia.</div>
            </div>
            <button type="button" class="btn btn-outline-primary btn-sm text-nowrap" id="pickReferenceUserBtn">
              <svg class="icon"><use href="#i-search"/></svg> Wybierz użytkownika wzorcowego
            </button>
          </div>
          <div class="reference-selected d-none" id="newUserReferenceSelected">
            <span class="reference-avatar" id="newUserReferenceAvatar">?</span>
            <div class="flex-grow-1 min-w-0">
              <div class="small text-muted">Użytkownik wzorcowy</div>
              <div class="fw-semibold text-truncate" id="newUserReferenceName">–</div>
              <div class="small text-muted text-truncate" id="newUserReferenceMeta">–</div>
            </div>
            <div class="d-flex gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary" id="changeReferenceUserBtn">Zmień</button>
              <button type="button" class="btn btn-sm btn-outline-secondary" id="clearReferenceUserBtn" title="Usuń wzorzec" aria-label="Usuń wzorzec"><svg class="icon"><use href="#i-x"/></svg></button>
            </div>
          </div>
          <div class="reference-copy d-none" id="newUserCopyWrap">
            <button type="button" class="btn btn-sm copy-toggle" id="newUserCopyPermsBtn" aria-pressed="false">
              <span class="copy-toggle-icon"><svg class="icon"><use href="#i-copy"/></svg></span>
              <span class="copy-toggle-label">Kopiuj uprawnienia od wzorca</span>
            </button>
            <span class="small text-muted" id="newUserCopyInfo">Zaznaczy w kolejnych krokach te same uprawnienia, udziały i grupy co u wzorca.</span>
          </div>
        </div>
        <input type="hidden" name="referenceUserDn" id="newUserReferenceDn" />

        <!-- Konto serwisowe: nazwa -->
        <div class="form-section d-none" data-type-only="service">
          <div class="form-section-title">Konto serwisowe</div>
          <label class="form-label" for="newUserServiceName">Nazwa konta / usługi <span class="text-danger">*</span></label>
          <input class="form-control" id="newUserServiceName" placeholder="np. Backup SQL" maxlength="64" />
          <div class="field-hint">Używana jako nazwa wyświetlana; login powstaje automatycznie jako <code>svc_nazwa</code>.</div>
        </div>

        <!-- Dane osobowe -->
        <div class="form-section" data-type-only="eskulap-domain">
          <div class="form-section-title">Dane osobowe</div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="newUserFirstName">Imię <span class="text-danger">*</span></label>
              <input class="form-control" name="firstName" id="newUserFirstName" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="newUserLastName">Nazwisko <span class="text-danger">*</span></label>
              <input class="form-control" name="lastName" id="newUserLastName" required />
            </div>
          </div>
        </div>

        <!-- Konto -->
        <div class="form-section">
          <div class="form-section-title">Konto</div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="newUserLogin">Login <span class="text-danger">*</span></label>
              <div class="input-group">
                <input class="form-control font-monospace" name="login" id="newUserLogin" placeholder="nazwisko.i" required spellcheck="false" />
                <button class="btn btn-outline-secondary" type="button" id="regenerateLoginBtn" title="Wygeneruj ponownie z imienia i nazwiska">
                  <svg class="icon"><use href="#i-refresh"/></svg>
                </button>
              </div>
              <div class="field-hint" id="newUserLoginStatus">Generowany automatycznie po wpisaniu imienia i nazwiska. Można go zmienić.</div>
              <div class="field-hint text-muted" id="newUserUpnPreview"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="newUserPassword">Hasło początkowe <span class="text-danger">*</span></label>
              <div class="input-group">
                <input class="form-control font-monospace" name="password" id="newUserPassword" type="password" required autocomplete="new-password" />
                <button class="btn btn-outline-secondary" type="button" id="toggleNewUserPasswordBtn" title="Pokaż / ukryj hasło"><svg class="icon"><use href="#i-eye"/></svg></button>
                <button class="btn btn-outline-secondary" type="button" id="generateNewUserPasswordBtn" title="Wygeneruj silne hasło"><svg class="icon"><use href="#i-key"/></svg></button>
              </div>
              <div class="mt-2">
                <div class="form-check">
                  <input class="form-check-input pwd-option" type="checkbox" name="mustChangePasswordAtNextLogon" id="newUserMustChangePwd">
                  <label class="form-check-label" for="newUserMustChangePwd">Wymuś zmianę hasła przy pierwszym logowaniu</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input pwd-option" type="checkbox" name="userCannotChangePassword" id="newUserCannotChangePwd" checked>
                  <label class="form-check-label" for="newUserCannotChangePwd">Użytkownik nie może zmienić hasła</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input pwd-option" type="checkbox" name="passwordNeverExpires" id="newUserPwdNeverExpires" checked>
                  <label class="form-check-label" for="newUserPwdNeverExpires">Hasło nigdy nie wygasa</label>
                </div>
                <div class="field-hint d-none" id="newUserPwdOptionsHint"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Lokalizacja -->
        <div class="form-section">
          <div class="form-section-title">Lokalizacja w katalogu <span class="text-danger ms-1">*</span></div>
          <div class="ou-field" data-target-input="newUserOuDn">
            <input type="hidden" name="ouDn" id="newUserOuDn" />
            <button type="button" class="ou-field-btn pick-ou-btn" data-target-input="newUserOuDn">
              <svg class="icon"><use href="#i-folder"/></svg>
              <span class="ou-field-text" data-placeholder="Wybierz jednostkę organizacyjną…">Wybierz jednostkę organizacyjną…</span>
              <svg class="icon ou-field-caret"><use href="#i-chevron-down"/></svg>
            </button>
          </div>
          <div class="field-hint d-none" id="newUserOuFromReference">Skopiowano z użytkownika wzorcowego.</div>
          <div class="field-hint d-none" id="newUserOuLocked">Konta serwisowe są zawsze tworzone w OU wskazanym w Ustawieniach.</div>
        </div>

        <!-- Zaawansowane -->
        <div class="form-section mb-0">
          <button class="advanced-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#newUserAdvanced" aria-expanded="false">
            <svg class="icon"><use href="#i-chevron-right"/></svg> Opcje zaawansowane
          </button>
          <div class="collapse" id="newUserAdvanced">
            <div class="row g-3 pt-3">
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="accountDisabled" id="newUserAccountDisabled">
                  <label class="form-check-label" for="newUserAccountDisabled">Utwórz konto jako wyłączone</label>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label small text-muted mb-1">Wygasanie konta</label>
                <div class="d-flex gap-3 mb-2">
                  <div class="form-check m-0">
                    <input class="form-check-input" type="radio" name="accountExpiresModeNewUser" id="newUserExpiresNever" value="never" checked>
                    <label class="form-check-label" for="newUserExpiresNever">Nigdy</label>
                  </div>
                  <div class="form-check m-0">
                    <input class="form-check-input" type="radio" name="accountExpiresModeNewUser" id="newUserExpiresDate" value="date">
                    <label class="form-check-label" for="newUserExpiresDate">Z dniem</label>
                  </div>
                </div>
                <input class="form-control form-control-sm" type="date" name="accountExpiresDate" disabled>
              </div>
              <div class="col-12">
                <label class="form-label small text-muted mb-1" for="newUserDescription">Opis</label>
                <textarea class="form-control" name="description" id="newUserDescription" rows="2" placeholder="np. stanowisko, oddział"></textarea>
              </div>
            </div>
          </div>
        </div>
        </div>

        <!-- Krok 3: uprawnienia -->
        <div class="wizard-pane d-none" data-pane="3">
          <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <div class="form-section-title mb-0">Uprawnienia do aplikacji i systemów <span class="badge rounded-pill text-bg-primary ms-1" id="newUserPermCount">0</span></div>
          </div>
          <div class="search-input-wrap mb-2">
            <svg class="icon search-input-icon"><use href="#i-search"/></svg>
            <input class="form-control" id="newUserPermSearch" placeholder="Szukaj uprawnienia, opisu lub grupy…" autocomplete="off" />
          </div>
          <div class="perm-list" id="newUserPermList"></div>
        </div>

        <!-- Krok 4: udziały sieciowe -->
        <div class="wizard-pane d-none" data-pane="4">
          <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <div class="form-section-title mb-0">Udziały sieciowe <span class="badge rounded-pill text-bg-primary ms-1" id="newUserShareCount">0</span></div>
            <div class="small text-muted">Odczyt = grupa <code>-r</code>, odczyt i zapis = grupa <code>-rw</code> (bez grupy <code>-r</code>).</div>
          </div>
          <div class="search-input-wrap mb-2">
            <svg class="icon search-input-icon"><use href="#i-search"/></svg>
            <input class="form-control" id="newUserShareSearch" placeholder="Szukaj udziału, ścieżki lub opisu…" autocomplete="off" />
          </div>
          <div class="perm-list" id="newUserShareList"></div>
        </div>

        <!-- Krok 5: inne grupy -->
        <div class="wizard-pane d-none" data-pane="5">
          <div class="field-hint mt-0 mb-3">Dowolne grupy AD spoza słownika uprawnień i udziałów.</div>
        <!-- Grupy -->
        <div class="form-section mb-0">
          <div class="d-flex flex-column gap-2 mb-2">
            <div class="form-section-title mb-0">Inne grupy AD <span class="badge rounded-pill text-bg-light border ms-1" id="newUserGroupsCount">0</span></div>
            <div class="d-flex gap-2 flex-wrap">
              <button type="button" class="btn btn-sm btn-outline-primary" id="newUserAddGroupBtn"><svg class="icon"><use href="#i-plus"/></svg> Dodaj grupę</button>
            </div>
          </div>
          <div class="chip-list" id="newUserGroupsList">
            <div class="chip-empty">Brak innych grup. Grupy z uprawnień i udziałów są dodawane automatycznie.</div>
          </div>
        </div>

        </div>

        <!-- Krok 6: podsumowanie -->
        <div class="wizard-pane d-none" data-pane="6">
          <div class="alert alert-info small d-flex align-items-center gap-2 mb-3">
            <svg class="icon"><use href="#i-info"/></svg>
            <span>Sprawdź dane. Konto zostanie utworzone dopiero po kliknięciu <strong>Utwórz użytkownika</strong>.</span>
          </div>
          <div id="newUserFinalSummary"></div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary me-auto" data-bs-dismiss="modal">Anuluj</button>
        <button type="button" class="btn btn-outline-secondary d-none" id="newUserBackBtn"><svg class="icon"><use href="#i-chevron-left"/></svg> Wstecz</button>
        <button type="button" class="btn btn-primary" id="newUserNextBtn" disabled><span id="newUserNextLabel">Informacje o użytkowniku</span> <svg class="icon"><use href="#i-chevron-right"/></svg></button>
        <button class="btn btn-primary d-none" id="newUserSubmitBtn" type="submit" disabled>
          <span class="spinner-border spinner-border-sm d-none me-1" id="newUserSubmitSpinner"></span>
          Utwórz użytkownika
        </button>
      </div>
    </form>
  </div>
</div>
