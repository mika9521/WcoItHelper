<div class="modal fade" id="newUserModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <form id="newUserForm" class="modal-content" autocomplete="off" novalidate>
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon"><svg class="icon"><use href="#i-user-plus"/></svg></span>
          <div>
            <h5 class="modal-title">Nowy użytkownik</h5>
            <div class="modal-subtitle">Utwórz konto w Active Directory</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <!-- Użytkownik wzorcowy -->
        <div class="reference-bar" id="newUserReferenceBar">
          <div class="reference-empty" id="newUserReferenceEmpty">
            <span class="reference-icon"><svg class="icon"><use href="#i-copy"/></svg></span>
            <div class="flex-grow-1">
              <div class="fw-semibold">Utwórz na wzór istniejącego konta</div>
              <div class="small text-muted">Wybierz użytkownika wzorcowego, aby skopiować jego OU i grupy.</div>
            </div>
            <button type="button" class="btn btn-outline-primary btn-sm text-nowrap" id="pickReferenceUserBtn">
              <svg class="icon"><use href="#i-search"/></svg> Wybierz użytkownika wzorcowego
            </button>
          </div>
          <div class="reference-selected d-none" id="newUserReferenceSelected">
            <span class="reference-avatar" id="newUserReferenceAvatar">?</span>
            <div class="flex-grow-1 min-w-0">
              <div class="small text-muted">Użytkownik wzorcowy</div>
              <div class="fw-semibold text-truncate" id="newUserReferenceName">–</div>
              <div class="small text-muted text-truncate" id="newUserReferenceMeta">–</div>
            </div>
            <div class="d-flex gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary" id="changeReferenceUserBtn">Zmień</button>
              <button type="button" class="btn btn-sm btn-outline-secondary" id="clearReferenceUserBtn" title="Usuń wzorzec" aria-label="Usuń wzorzec"><svg class="icon"><use href="#i-x"/></svg></button>
            </div>
          </div>
        </div>
        <input type="hidden" name="referenceUserDn" id="newUserReferenceDn" />

        <!-- Dane osobowe -->
        <div class="form-section">
          <div class="form-section-title">Dane osobowe</div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="newUserFirstName">Imię <span class="text-danger">*</span></label>
              <input class="form-control" name="firstName" id="newUserFirstName" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="newUserLastName">Nazwisko <span class="text-danger">*</span></label>
              <input class="form-control" name="lastName" id="newUserLastName" required />
            </div>
          </div>
        </div>

        <!-- Konto -->
        <div class="form-section">
          <div class="form-section-title">Konto</div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="newUserLogin">Login <span class="text-danger">*</span></label>
              <div class="input-group">
                <input class="form-control font-monospace" name="login" id="newUserLogin" placeholder="nazwisko.i" required spellcheck="false" />
                <button class="btn btn-outline-secondary" type="button" id="regenerateLoginBtn" title="Wygeneruj ponownie z imienia i nazwiska">
                  <svg class="icon"><use href="#i-refresh"/></svg>
                </button>
              </div>
              <div class="field-hint" id="newUserLoginStatus">Generowany automatycznie po wpisaniu imienia i nazwiska. Można go zmienić.</div>
              <div class="field-hint text-muted" id="newUserUpnPreview"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="newUserPassword">Hasło początkowe <span class="text-danger">*</span></label>
              <div class="input-group">
                <input class="form-control font-monospace" name="password" id="newUserPassword" type="password" required autocomplete="new-password" />
                <button class="btn btn-outline-secondary" type="button" id="toggleNewUserPasswordBtn" title="Pokaż / ukryj hasło"><svg class="icon"><use href="#i-eye"/></svg></button>
                <button class="btn btn-outline-secondary" type="button" id="generateNewUserPasswordBtn" title="Wygeneruj silne hasło"><svg class="icon"><use href="#i-key"/></svg></button>
              </div>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="mustChangePasswordAtNextLogon" id="newUserMustChangePwd" checked>
                <label class="form-check-label" for="newUserMustChangePwd">Wymuś zmianę hasła przy pierwszym logowaniu</label>
              </div>
            </div>
          </div>
        </div>

        <!-- Lokalizacja -->
        <div class="form-section">
          <div class="form-section-title">Lokalizacja w katalogu <span class="text-danger ms-1">*</span></div>
          <div class="ou-field" data-target-input="newUserOuDn">
            <input type="hidden" name="ouDn" id="newUserOuDn" />
            <button type="button" class="ou-field-btn pick-ou-btn" data-target-input="newUserOuDn">
              <svg class="icon"><use href="#i-folder"/></svg>
              <span class="ou-field-text" data-placeholder="Wybierz jednostkę organizacyjną…">Wybierz jednostkę organizacyjną…</span>
              <svg class="icon ou-field-caret"><use href="#i-chevron-down"/></svg>
            </button>
          </div>
          <div class="field-hint d-none" id="newUserOuFromReference">Skopiowano z użytkownika wzorcowego.</div>
        </div>

        <!-- Grupy -->
        <div class="form-section">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="form-section-title mb-0">Grupy <span class="badge rounded-pill text-bg-light border ms-1" id="newUserGroupsCount">0</span></div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="newUserAddGroupBtn"><svg class="icon"><use href="#i-plus"/></svg> Dodaj grupę</button>
          </div>
          <div class="chip-list" id="newUserGroupsList">
            <div class="chip-empty">Brak grup. Wybierz użytkownika wzorcowego lub dodaj grupy ręcznie.</div>
          </div>
        </div>

        <!-- Zaawansowane -->
        <div class="form-section mb-0">
          <button class="advanced-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#newUserAdvanced" aria-expanded="false">
            <svg class="icon"><use href="#i-chevron-right"/></svg> Opcje zaawansowane
          </button>
          <div class="collapse" id="newUserAdvanced">
            <div class="row g-3 pt-3">
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="userCannotChangePassword" id="newUserCannotChangePwd">
                  <label class="form-check-label" for="newUserCannotChangePwd">Użytkownik nie może zmienić hasła</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="passwordNeverExpires" id="newUserPwdNeverExpires">
                  <label class="form-check-label" for="newUserPwdNeverExpires">Hasło nigdy nie wygasa</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="accountDisabled" id="newUserAccountDisabled">
                  <label class="form-check-label" for="newUserAccountDisabled">Utwórz konto jako wyłączone</label>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label small text-muted mb-1">Wygasanie konta</label>
                <div class="d-flex gap-3 mb-2">
                  <div class="form-check m-0">
                    <input class="form-check-input" type="radio" name="accountExpiresModeNewUser" id="newUserExpiresNever" value="never" checked>
                    <label class="form-check-label" for="newUserExpiresNever">Nigdy</label>
                  </div>
                  <div class="form-check m-0">
                    <input class="form-check-input" type="radio" name="accountExpiresModeNewUser" id="newUserExpiresDate" value="date">
                    <label class="form-check-label" for="newUserExpiresDate">Z dniem</label>
                  </div>
                </div>
                <input class="form-control form-control-sm" type="date" name="accountExpiresDate" disabled>
              </div>
              <div class="col-12">
                <label class="form-label small text-muted mb-1" for="newUserDescription">Opis</label>
                <textarea class="form-control" name="description" id="newUserDescription" rows="2" placeholder="np. stanowisko, oddział"></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
        <button class="btn btn-primary" id="newUserSubmitBtn" type="submit" disabled>
          <span class="spinner-border spinner-border-sm d-none me-1" id="newUserSubmitSpinner"></span>
          Utwórz użytkownika
        </button>
      </div>
    </form>
  </div>
</div>
