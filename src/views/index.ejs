<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portal Zarządzania AD</title>
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body data-ad-domain="<%= typeof adDomain !== 'undefined' ? adDomain : '' %>">
<%- include('partials/icons') %>

<div class="app-shell">
  <aside class="app-sidebar">
    <div class="app-sidebar-brand">
      <span class="app-brand-mark"><svg class="icon"><use href="#i-shield"/></svg></span>
      <span class="app-brand-text">
        <span class="app-brand-title">Portal AD</span>
        <span class="app-brand-sub"><%= typeof adDomain !== 'undefined' && adDomain ? adDomain : 'Active Directory' %></span>
      </span>
    </div>

    <div class="app-nav-label">Nawigacja</div>
    <ul class="app-sidebar-nav" role="tablist">
      <li>
        <button class="app-nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-panel" data-page-title="Dashboard" data-page-sub="Przegląd stanu katalogu Active Directory" type="button" role="tab">
          <svg class="icon"><use href="#i-dashboard"/></svg><span>Dashboard</span>
        </button>
      </li>
      <li>
        <button class="app-nav-link" id="search-tab" data-bs-toggle="tab" data-bs-target="#search-panel" data-page-title="Wyszukiwarka" data-page-sub="Znajdź użytkowników, komputery i grupy" type="button" role="tab">
          <svg class="icon"><use href="#i-search"/></svg><span>Wyszukiwarka</span>
        </button>
      </li>
      <li>
        <button class="app-nav-link" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-panel" data-page-title="Raporty" data-page-sub="Raporty katalogu i aktywności portalu" type="button" role="tab">
          <svg class="icon"><use href="#i-report"/></svg><span>Raporty</span>
        </button>
      </li>
      <li>
        <button class="app-nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-panel" data-page-title="Ustawienia" data-page-sub="Uprawnienia i udziały sieciowe oraz ich mapowanie na grupy AD" type="button" role="tab">
          <svg class="icon"><use href="#i-settings"/></svg><span>Ustawienia</span>
        </button>
      </li>
    </ul>

    <div class="app-nav-label">Szybkie akcje</div>
    <ul class="app-sidebar-nav">
      <li>
        <button class="app-nav-link" type="button" data-bs-toggle="modal" data-bs-target="#newUserModal">
          <svg class="icon"><use href="#i-user-plus"/></svg><span>Nowy użytkownik</span>
        </button>
      </li>
      <li>
        <button class="app-nav-link" type="button" data-bs-toggle="modal" data-bs-target="#newGroupModal">
          <svg class="icon"><use href="#i-group"/></svg><span>Nowa grupa</span>
        </button>
      </li>
    </ul>

    <div class="app-sidebar-user">
      <div class="app-user-avatar"><%= (user.displayName || '?').trim().charAt(0).toUpperCase() %></div>
      <div class="app-user-info">
        <div class="app-user-name" title="<%= user.displayName %>"><%= user.displayName %></div>
        <div class="app-user-login"><%= user.login %></div>
      </div>
      <form action="/logout" method="post">
        <button class="app-logout-btn" title="Wyloguj" aria-label="Wyloguj"><svg class="icon"><use href="#i-logout"/></svg></button>
      </form>
    </div>
  </aside>

  <main class="app-main">
    <header class="app-page-header">
      <div>
        <h1 class="app-page-title" id="pageTitle">Dashboard</h1>
        <div class="app-page-sub" id="pageSub">Przegląd stanu katalogu Active Directory</div>
      </div>
      <div class="app-page-actions">
        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#newGroupModal">
          <svg class="icon"><use href="#i-group"/></svg> Nowa grupa
        </button>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newUserModal">
          <svg class="icon"><use href="#i-user-plus"/></svg> Nowy użytkownik
        </button>
      </div>
    </header>

    <div class="tab-content">
      <!-- ===== Dashboard ===== -->
      <section class="tab-pane fade show active" id="dashboard-panel" role="tabpanel" aria-labelledby="dashboard-tab">
        <div class="row g-3 mb-4" id="dashboardStats">
          <div class="col-sm-6 col-xl-4">
            <div class="kpi-card"><span class="kpi-icon kpi-blue"><svg class="icon"><use href="#i-users"/></svg></span>
              <div><div class="kpi-label">Użytkownicy</div><div class="kpi-value" id="statUsers">–</div></div></div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="kpi-card"><span class="kpi-icon kpi-green"><svg class="icon"><use href="#i-user-check"/></svg></span>
              <div><div class="kpi-label">Aktywni użytkownicy</div><div class="kpi-value" id="statActiveUsers">–</div></div></div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="kpi-card"><span class="kpi-icon kpi-teal"><svg class="icon"><use href="#i-shield"/></svg></span>
              <div><div class="kpi-label">Aktywni (bez OU zablokowanych)</div><div class="kpi-value" id="statActiveUsersWithoutBlockedOu">–</div></div></div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="kpi-card"><span class="kpi-icon kpi-indigo"><svg class="icon"><use href="#i-group"/></svg></span>
              <div><div class="kpi-label">Grupy</div><div class="kpi-value" id="statGroups">–</div></div></div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="kpi-card"><span class="kpi-icon kpi-slate"><svg class="icon"><use href="#i-computer"/></svg></span>
              <div><div class="kpi-label">Komputery</div><div class="kpi-value" id="statComputers">–</div></div></div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="kpi-card"><span class="kpi-icon kpi-amber"><svg class="icon"><use href="#i-folder"/></svg></span>
              <div><div class="kpi-label">Jednostki organizacyjne</div><div class="kpi-value" id="statOus">–</div></div></div>
          </div>
          <div class="col-sm-6 col-xl-6">
            <button type="button" class="kpi-card kpi-card-link" data-stale-report="stale-users" title="Otwórz raport nieaktywnych użytkowników">
              <span class="kpi-icon kpi-red"><svg class="icon"><use href="#i-clock"/></svg></span>
              <div class="text-start"><div class="kpi-label">Konta bez logowania od 2 lat</div><div class="kpi-value" id="statStaleUsers">–</div>
              <div class="kpi-hint">włączone, poza OU zablokowane_konta</div></div>
              <svg class="icon kpi-link-caret"><use href="#i-chevron-right"/></svg>
            </button>
          </div>
          <div class="col-sm-6 col-xl-6">
            <button type="button" class="kpi-card kpi-card-link" data-stale-report="stale-computers" title="Otwórz raport nieaktywnych komputerów">
              <span class="kpi-icon kpi-orange"><svg class="icon"><use href="#i-computer"/></svg></span>
              <div class="text-start"><div class="kpi-label">Komputery bez logowania od roku</div><div class="kpi-value" id="statStaleComputers">–</div>
              <div class="kpi-hint">włączone konta komputerów</div></div>
              <svg class="icon kpi-link-caret"><use href="#i-chevron-right"/></svg>
            </button>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-lg-8">
            <section class="card h-100">
              <div class="card-header">Szybkie akcje</div>
              <div class="card-body">
                <div class="quick-actions">
                  <button class="quick-action" type="button" data-bs-toggle="modal" data-bs-target="#newUserModal">
                    <span class="quick-action-icon"><svg class="icon"><use href="#i-user-plus"/></svg></span>
                    <span><span class="quick-action-title">Nowy użytkownik</span><span class="quick-action-sub">Kreator konta, opcjonalnie na wzór innego</span></span>
                  </button>
                  <button class="quick-action" type="button" data-bs-toggle="modal" data-bs-target="#newGroupModal">
                    <span class="quick-action-icon"><svg class="icon"><use href="#i-group"/></svg></span>
                    <span><span class="quick-action-title">Nowa grupa</span><span class="quick-action-sub">Grupa zabezpieczeń w wybranym OU</span></span>
                  </button>
                  <button class="quick-action" type="button" data-goto-tab="search-tab">
                    <span class="quick-action-icon"><svg class="icon"><use href="#i-search"/></svg></span>
                    <span><span class="quick-action-title">Wyszukaj obiekt</span><span class="quick-action-sub">Użytkownicy, komputery, grupy</span></span>
                  </button>
                  <button class="quick-action" type="button" data-goto-tab="reports-tab">
                    <span class="quick-action-icon"><svg class="icon"><use href="#i-report"/></svg></span>
                    <span><span class="quick-action-title">Raporty</span><span class="quick-action-sub">Nieaktywne konta, aktywność, logowania</span></span>
                  </button>
                </div>
              </div>
            </section>
          </div>
          <div class="col-lg-4">
            <section class="card h-100">
              <div class="card-header">Podsumowanie</div>
              <div class="card-body d-flex flex-column justify-content-center">
                <div class="kpi-label">Łącznie obiektów</div>
                <div class="kpi-value kpi-value-lg" id="statTotal">–</div>
                <div class="text-muted small mt-1">użytkownicy + grupy + komputery</div>
              </div>
            </section>
          </div>
        </div>
      </section>

      <!-- ===== Wyszukiwarka ===== -->
      <section class="tab-pane fade" id="search-panel" role="tabpanel" aria-labelledby="search-tab">
        <section class="card mb-3">
          <div class="card-body">
            <form class="search-toolbar" id="searchForm" autocomplete="off">
              <div class="segmented" role="radiogroup" aria-label="Typ obiektu">
                <input type="radio" class="btn-check" name="typeFilter" id="tf-all" value="all" checked>
                <label for="tf-all">Wszystkie</label>
                <input type="radio" class="btn-check" name="typeFilter" id="tf-user" value="user">
                <label for="tf-user">Użytkownicy</label>
                <input type="radio" class="btn-check" name="typeFilter" id="tf-computer" value="computer">
                <label for="tf-computer">Komputery</label>
                <input type="radio" class="btn-check" name="typeFilter" id="tf-group" value="group">
                <label for="tf-group">Grupy</label>
              </div>
              <div class="search-input-wrap" id="searchTextWrap">
                <svg class="icon search-input-icon"><use href="#i-search"/></svg>
                <input id="searchInput" class="form-control" placeholder="Szukaj… (% = dowolny ciąg, np. kow% lub %ski)" />
              </div>
              <button type="button" class="btn btn-outline-secondary" id="toggleFiltersBtn" data-bs-toggle="collapse" data-bs-target="#searchFilters" aria-expanded="false">
                <svg class="icon"><use href="#i-settings"/></svg> Filtry
                <span class="badge rounded-pill text-bg-primary d-none" id="activeFiltersCount">0</span>
              </button>
              <button type="submit" id="searchBtn" class="btn btn-primary search-btn"><svg class="icon"><use href="#i-search"/></svg> Szukaj</button>
            </form>

            <div class="collapse" id="searchFilters">
              <div class="search-filters">
                <div class="row g-3">
                  <div class="col-lg-6">
                    <label class="form-label">Jednostka organizacyjna</label>
                    <div class="d-flex gap-2 align-items-center">
                      <div class="ou-field flex-grow-1" data-target-input="searchOuDn">
                        <input type="hidden" id="searchOuDn" />
                        <button type="button" class="ou-field-btn pick-ou-btn" data-target-input="searchOuDn">
                          <svg class="icon"><use href="#i-folder"/></svg>
                          <span class="ou-field-text" data-placeholder="Cała domena">Cała domena</span>
                          <svg class="icon ou-field-caret"><use href="#i-chevron-down"/></svg>
                        </button>
                      </div>
                      <button type="button" class="btn-icon" id="clearSearchOuBtn" title="Cała domena" aria-label="Wyczyść OU"><svg class="icon"><use href="#i-x"/></svg></button>
                    </div>
                    <div class="form-check mt-2">
                      <input class="form-check-input" type="checkbox" id="searchSubtree" checked>
                      <label class="form-check-label" for="searchSubtree">Uwzględnij podjednostki</label>
                    </div>
                  </div>
                  <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="searchField">Szukaj w polu</label>
                    <select class="form-select" id="searchField">
                      <option value="any" title="nazwa, login, imię, nazwisko, e-mail">Dowolne</option>
                      <option value="sAMAccountName">Login (sAMAccountName)</option>
                      <option value="displayName">Nazwa wyświetlana</option>
                      <option value="givenName">Imię</option>
                      <option value="sn">Nazwisko</option>
                      <option value="mail">E-mail / UPN</option>
                      <option value="description">Opis</option>
                      <option value="department">Dział</option>
                      <option value="title">Stanowisko</option>
                    </select>
                  </div>
                  <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="searchStatus">Status konta</label>
                    <select class="form-select" id="searchStatus">
                      <option value="">Dowolny</option>
                      <option value="enabled">Tylko włączone</option>
                      <option value="disabled">Tylko wyłączone</option>
                    </select>
                  </div>
                  <div class="col-sm-8 col-lg-6">
                    <label class="form-label" for="searchLogon">Ostatnie logowanie</label>
                    <div class="d-flex gap-2">
                      <select class="form-select" id="searchLogon">
                        <option value="">Dowolne</option>
                        <option value="within">W ciągu ostatnich…</option>
                        <option value="older">Brak logowania od… (lub nigdy)</option>
                        <option value="never">Nigdy się nie logował</option>
                      </select>
                      <div class="input-group search-days d-none" id="searchDaysWrap">
                        <input type="number" class="form-control" id="searchDays" value="90" min="1" />
                        <span class="input-group-text">dni</span>
                      </div>
                    </div>
                  </div>
                  <div class="col-sm-4 col-lg-3">
                    <label class="form-label" for="searchLimit">Maks. wyników</label>
                    <select class="form-select" id="searchLimit">
                      <option value="50">50</option>
                      <option value="100">100</option>
                      <option value="250">250</option>
                      <option value="500">500</option>
                    </select>
                  </div>
                  <div class="col-lg-3 d-flex align-items-end justify-content-lg-end">
                    <button type="button" class="btn btn-link text-decoration-none px-0" id="resetFiltersBtn">Wyczyść filtry</button>
                  </div>
                </div>
                <div class="field-hint mt-3">
                  <strong>Wzorce:</strong> <code>kow</code> = zawiera „kow”, <code>kow%</code> = zaczyna się od, <code>%ski</code> = kończy się na, <code>%an%ski</code> = zawiera oba fragmenty w tej kolejności.
                  Puste pole + wybrane OU = cała zawartość OU.
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span>Wyniki</span>
              <span class="badge rounded-pill text-bg-light border" id="resultsCount">0</span>
              <span class="small text-warning-emphasis d-none" id="resultsTruncated"></span>
            </div>
            <button
              type="button"
              id="resultsLegendBtn"
              class="btn btn-sm btn-link text-muted text-decoration-none d-inline-flex align-items-center gap-1"
              data-bs-toggle="popover"
              data-bs-placement="left"
              data-bs-html="true"
              data-bs-title="Statusy kont"
              data-bs-content="<div class='legend-popover-body'>
                <div class='legend-row'><span class='status-pill status-active'>Aktywne</span><span>Konto włączone</span></div>
                <div class='legend-row'><span class='status-pill status-disabled'>Wyłączone</span><span>Konto wyłączone, w zwykłym OU</span></div>
                <div class='legend-row'><span class='status-pill status-blocked'>Zablokowane</span><span>Wyłączone i przeniesione do OU zablokowane_konta (soft delete)</span></div>
              </div>"
            ><svg class="icon"><use href="#i-info"/></svg> Legenda</button>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="resultsTable">
              <thead>
              <tr>
                <th class="sortable" data-sort="name">Obiekt</th>
                <th class="sortable" data-sort="path">Lokalizacja</th>
                <th class="sortable" data-sort="logon" style="width:170px;" title="lastLogonTimestamp – replikowany między kontrolerami, opóźnienie do ok. 14 dni">Ostatnie logowanie</th>
                <th class="sortable" data-sort="status" style="width:130px;">Status</th>
                <th style="width:150px;" class="text-end">Akcje</th>
              </tr>
              </thead>
              <tbody id="results">
                <tr><td colspan="5"><div class="empty-state"><svg class="icon"><use href="#i-search"/></svg><div>Wpisz frazę lub ustaw filtry i kliknij <strong>Szukaj</strong>, aby wyświetlić obiekty.</div></div></td></tr>
              </tbody>
            </table>
          </div>
        </section>
      </section>

      <!-- ===== Raporty ===== -->
      <section class="tab-pane fade" id="reports-panel" role="tabpanel" aria-labelledby="reports-tab">
        <div class="row g-3">
          <div class="col-lg-3">
            <section class="card">
              <div class="card-body p-2">
                <div class="report-nav" id="reportsList">
                  <button class="report-link active" data-report="stale-users" type="button">
                    <svg class="icon"><use href="#i-user"/></svg><span>Nieaktywni użytkownicy</span>
                  </button>
                  <button class="report-link" data-report="stale-computers" type="button">
                    <svg class="icon"><use href="#i-computer"/></svg><span>Nieaktywne komputery</span>
                  </button>
                  <button class="report-link" data-report="portal-activity" type="button">
                    <svg class="icon"><use href="#i-activity"/></svg><span>Aktywność portalu</span>
                  </button>
                  <button class="report-link" data-report="login-history" type="button">
                    <svg class="icon"><use href="#i-key"/></svg><span>Historia logowań</span>
                  </button>
                </div>
              </div>
            </section>
          </div>

          <div class="col-lg-9">
<% [
  { id: 'stale-users', kind: 'user', title: 'Nieaktywne konta użytkowników', hint: 'Włączone konta użytkowników bez logowania w podanym okresie. Konta utworzone w tym okresie są pomijane.' },
  { id: 'stale-computers', kind: 'computer', title: 'Nieaktywne komputery', hint: 'Włączone konta komputerów bez logowania do domeny w podanym okresie. Aktywny komputer zmienia też hasło konta co ok. 30 dni (kolumna „Hasło konta”).' }
].forEach((r, idx) => { %>
            <section class="card report-page stale-report <%= idx ? 'd-none' : '' %>" data-report-page="<%= r.id %>" data-kind="<%= r.kind %>">
              <div class="card-header">Raport: <%= r.title %></div>
              <div class="card-body">
                <div class="field-hint mt-0 mb-3"><%= r.hint %></div>
                <form class="row g-3 align-items-end mb-3 stale-form">
                  <div class="col-md-auto">
                    <label class="form-label">Brak logowania od</label>
                    <div class="input-group stale-period">
                      <input type="number" class="form-control stale-amount" value="<%= r.kind === 'computer' ? 90 : 2 %>" min="1" />
                      <select class="form-select stale-unit">
                        <option value="1" <%= r.kind === 'computer' ? 'selected' : '' %>>dni</option>
                        <option value="30">miesięcy</option>
                        <option value="365" <%= r.kind === 'computer' ? '' : 'selected' %>>lat</option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md">
                    <label class="form-label">Zakres</label>
                    <div class="d-flex gap-2 align-items-center">
                      <div class="ou-field flex-grow-1" data-target-input="staleOu-<%= r.kind %>">
                        <input type="hidden" id="staleOu-<%= r.kind %>" class="stale-ou" />
                        <button type="button" class="ou-field-btn pick-ou-btn" data-target-input="staleOu-<%= r.kind %>">
                          <svg class="icon"><use href="#i-folder"/></svg>
                          <span class="ou-field-text" data-placeholder="Cała domena">Cała domena</span>
                          <svg class="icon ou-field-caret"><use href="#i-chevron-down"/></svg>
                        </button>
                      </div>
                      <button type="button" class="btn-icon stale-clear-ou" title="Cała domena" aria-label="Wyczyść OU"><svg class="icon"><use href="#i-x"/></svg></button>
                    </div>
                  </div>
                  <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                    <div class="form-check m-0">
                      <input class="form-check-input stale-include-disabled" type="checkbox" id="staleDisabled-<%= r.kind %>">
                      <label class="form-check-label" for="staleDisabled-<%= r.kind %>">Pokaż także wyłączone konta</label>
                    </div>
                    <div class="ms-auto d-flex gap-2">
                      <button type="button" class="btn btn-outline-secondary stale-export" disabled>Eksportuj CSV</button>
                      <button type="submit" class="btn btn-primary">Generuj raport</button>
                    </div>
                  </div>
                </form>
                <div class="stale-result small"></div>
              </div>
            </section>
<% }) %>

            <section class="card report-page d-none" data-report-page="portal-activity">
              <div class="card-header">Aktywność portalu</div>
              <div class="card-body">
                <form id="portalActivityFilterForm" class="row g-2 mb-3">
                  <div class="col-md-4">
                    <input id="portalActivitySearch" class="form-control form-control-sm" placeholder="Użytkownik, akcja, DN…" />
                  </div>
                  <div class="col-md-2 col-6">
                    <input id="portalActivityFrom" type="date" class="form-control form-control-sm" title="Od" />
                  </div>
                  <div class="col-md-2 col-6">
                    <input id="portalActivityTo" type="date" class="form-control form-control-sm" title="Do" />
                  </div>
                  <div class="col-md-2 col-6">
                    <select id="portalActivityAction" class="form-select form-select-sm">
                      <option value="">Wszystkie akcje</option>
                    </select>
                  </div>
                  <div class="col-md-2 col-6">
                    <select id="portalActivityStatus" class="form-select form-select-sm">
                      <option value="">Każdy status</option>
                      <option value="success">success</option>
                      <option value="error">error</option>
                    </select>
                  </div>
                  <div class="col-12 d-flex justify-content-end gap-2">
                    <select id="portalActivityPageSize" class="form-select form-select-sm w-auto" title="Wierszy na stronę">
                      <option value="10">10 / str.</option>
                      <option value="20" selected>20 / str.</option>
                      <option value="50">50 / str.</option>
                    </select>
                    <button class="btn btn-sm btn-primary" type="submit">Filtruj</button>
                  </div>
                </form>
                <div id="portalActivityList" class="small text-muted">Ładowanie…</div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <button id="portalActivityPrev" class="btn btn-sm btn-outline-secondary">Poprzednia</button>
                  <div id="portalActivityPaginationInfo" class="small text-muted">–</div>
                  <button id="portalActivityNext" class="btn btn-sm btn-outline-secondary">Następna</button>
                </div>
              </div>
            </section>

            <section class="card report-page d-none" data-report-page="login-history">
              <div class="card-header">Historia logowań do portalu</div>
              <div class="card-body">
                <div id="loginHistoryList" class="small text-muted">Ładowanie…</div>
              </div>
            </section>
          </div>
        </div>
      </section>
      <!-- ===== Ustawienia ===== -->
      <section class="tab-pane fade" id="settings-panel" role="tabpanel" aria-labelledby="settings-tab">
        <section class="card mb-4">
          <div class="card-header">
            <div>Konta serwisowe</div>
            <div class="small text-muted fw-normal">Konta serwisowe (login <code>svc_nazwa</code>) są zawsze tworzone w tym OU.</div>
          </div>
          <div class="card-body">
            <div class="d-flex gap-2 align-items-center flex-wrap">
              <div class="ou-field flex-grow-1" data-target-input="settingsServiceOuDn" style="min-width: 280px;">
                <input type="hidden" id="settingsServiceOuDn" />
                <button type="button" class="ou-field-btn pick-ou-btn" data-target-input="settingsServiceOuDn">
                  <svg class="icon"><use href="#i-folder"/></svg>
                  <span class="ou-field-text" data-placeholder="Wybierz OU dla kont serwisowych…">Wybierz OU dla kont serwisowych…</span>
                  <svg class="icon ou-field-caret"><use href="#i-chevron-down"/></svg>
                </button>
              </div>
              <button type="button" class="btn btn-primary" id="saveServiceOuBtn" disabled>Zapisz</button>
            </div>
            <div class="field-hint" id="settingsServiceOuInfo"></div>
          </div>
        </section>

        <section class="card">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <div>Uprawnienia użytkowników</div>
              <div class="small text-muted fw-normal">Uprawnienia wybierane w kroku 3 kreatora nowego użytkownika. Każde uprawnienie dodaje konto do przypisanych grup AD.</div>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="addPermissionBtn"><svg class="icon"><use href="#i-plus"/></svg> Dodaj uprawnienie</button>
          </div>
          <div class="card-body pb-2">
            <div class="search-input-wrap" style="max-width: 420px;">
              <svg class="icon search-input-icon"><use href="#i-search"/></svg>
              <input class="form-control" id="permissionsSearch" placeholder="Szukaj uprawnienia, opisu lub grupy…" autocomplete="off" />
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 settings-table" id="permissionsTable">
              <thead>
                <tr><th>Uprawnienie</th><th>Grupy AD</th><th style="width:170px;">Ostatnia zmiana</th><th style="width:110px;" class="text-end">Akcje</th></tr>
              </thead>
              <tbody id="permissionsTableBody">
                <tr><td colspan="4"><div class="empty-state"><span class="spinner-border spinner-border-sm text-primary"></span><div>Ładowanie…</div></div></td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="card mt-4">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <div>Udziały sieciowe</div>
              <div class="small text-muted fw-normal">Udziały wybierane w kroku 4 kreatora. Każdy udział ma grupę tylko do odczytu (<code>-r</code>) i grupę do odczytu i zapisu (<code>-rw</code>).</div>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="addShareBtn"><svg class="icon"><use href="#i-plus"/></svg> Dodaj udział</button>
          </div>
          <div class="card-body pb-2">
            <div class="search-input-wrap" style="max-width: 420px;">
              <svg class="icon search-input-icon"><use href="#i-search"/></svg>
              <input class="form-control" id="sharesSearch" placeholder="Szukaj udziału, ścieżki lub grupy…" autocomplete="off" />
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 settings-table" id="sharesTable">
              <thead>
                <tr><th>Udział</th><th>Ścieżka</th><th>Grupy AD</th><th style="width:170px;">Ostatnia zmiana</th><th style="width:110px;" class="text-end">Akcje</th></tr>
              </thead>
              <tbody id="sharesTableBody">
                <tr><td colspan="5"><div class="empty-state"><span class="spinner-border spinner-border-sm text-primary"></span><div>Ładowanie…</div></div></td></tr>
              </tbody>
            </table>
          </div>
        </section>
      </section>
    </div>
  </main>
</div>

<%- include('modals/objectModal') %>
<%- include('modals/newUserModal') %>
<%- include('modals/newGroupModal') %>
<%- include('modals/ouPickerModal') %>
<%- include('modals/groupToolsModals') %>
<%- include('modals/permissionModal') %>
<%- include('modals/shareModal') %>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="appToast" class="toast app-toast align-items-center border-0" role="alert">
    <div class="d-flex align-items-center">
      <span class="app-toast-icon"><svg class="icon"><use href="#i-check"/></svg></span>
      <div class="toast-body" id="toastBody"></div>
      <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/vendor/jspdf/jspdf.umd.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
