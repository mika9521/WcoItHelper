<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portal Zarządzania AD</title>
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<div class="app-shell">
  <aside class="app-sidebar">
    <div class="app-sidebar-brand">
      <span class="app-sidebar-brand-icon">AD</span>
      <span class="app-sidebar-brand-text">Portal<br />Zarządzania AD</span>
    </div>
    <ul class="app-sidebar-nav" role="tablist">
      <li>
        <button class="app-nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-panel" type="button" role="tab">
          Dashboard
        </button>
      </li>
      <li>
        <button class="app-nav-link" id="search-tab" data-bs-toggle="tab" data-bs-target="#search-panel" type="button" role="tab">
          Wyszukiwarka
        </button>
      </li>
      <li>
        <button class="app-nav-link" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-panel" type="button" role="tab">
          Raporty
        </button>
      </li>
    </ul>
    <div class="app-sidebar-user">
      <div class="app-user-avatar"><%= (user.displayName || '?').trim().charAt(0).toUpperCase() %></div>
      <div class="app-user-info">
        <div class="app-user-name"><%= user.displayName %></div>
        <form action="/logout" method="post">
          <button class="app-logout-btn">Wyloguj</button>
        </form>
      </div>
    </div>
  </aside>

  <main class="app-main">
  <div class="tab-content">
    <section class="tab-pane fade show active" id="dashboard-panel" role="tabpanel" aria-labelledby="dashboard-tab">
      <section class="card mb-4">
        <div class="card-header">Statystyki Active Directory</div>
        <div class="card-body">
          <div class="row g-3" id="dashboardStats">
            <div class="col-md-4 col-xl-3"><div class="card stat-card"><div class="card-body"><div class="stat-icon" aria-hidden="true"></div><div><div class="text-muted small">Użytkownicy</div><div class="h4 mb-0" id="statUsers">-</div></div></div></div></div>
            <div class="col-md-4 col-xl-3"><div class="card stat-card"><div class="card-body"><div class="stat-icon" aria-hidden="true"></div><div><div class="text-muted small">Aktywni użytkownicy</div><div class="h4 mb-0" id="statActiveUsers">-</div></div></div></div></div>
            <div class="col-md-4 col-xl-3"><div class="card stat-card"><div class="card-body"><div class="stat-icon" aria-hidden="true"></div><div><div class="text-muted small">Aktywni bez OU zablokowanych</div><div class="h4 mb-0" id="statActiveUsersWithoutBlockedOu">-</div></div></div></div></div>
            <div class="col-md-4 col-xl-3"><div class="card stat-card"><div class="card-body"><div class="stat-icon" aria-hidden="true"></div><div><div class="text-muted small">Grupy</div><div class="h4 mb-0" id="statGroups">-</div></div></div></div></div>
            <div class="col-md-4 col-xl-3"><div class="card stat-card"><div class="card-body"><div class="stat-icon" aria-hidden="true"></div><div><div class="text-muted small">Komputery</div><div class="h4 mb-0" id="statComputers">-</div></div></div></div></div>
            <div class="col-md-4 col-xl-3"><div class="card stat-card"><div class="card-body"><div class="stat-icon" aria-hidden="true"></div><div><div class="text-muted small">OU</div><div class="h4 mb-0" id="statOus">-</div></div></div></div></div>
          </div>
          <div class="mt-3 text-muted small">Łącznie obiektów (użytkownicy + grupy + komputery): <strong id="statTotal">-</strong></div>
        </div>
      </section>
    </section>

    <section class="tab-pane fade" id="search-panel" role="tabpanel" aria-labelledby="search-tab">
      <section class="card mb-4">
        <div class="card-body">
          <div class="row g-2">
            <div class="col-md-3">
              <select id="typeFilter" class="form-select">
                <option value="all">Wszystkie</option>
                <option value="user">Użytkownicy</option>
                <option value="computer">Komputery</option>
                <option value="group">Grupy zabezpieczeń</option>
                <option value="ou-selection">Wybór OU</option>
              </select>
            </div>
            <div class="col-md-7" id="searchTextWrap">
              <input id="searchInput" class="form-control" placeholder="Szukaj: user, komputer, grupa..." />
            </div>
            <div class="col-md-7 d-none" id="searchOuWrap">
              <div class="input-group">
                <input id="searchOuDn" class="form-control" placeholder="Wybierz OU..." readonly />
                <button class="btn btn-outline-secondary pick-ou-btn" data-target-input="searchOuDn" data-ou-only="1">Wybierz OU</button>
              </div>
            </div>
            <div class="col-md-2 d-grid">
              <button id="searchBtn" class="btn btn-primary">Szukaj</button>
            </div>
          </div>
        </div>
      </section>

      <section class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span>Wyniki</span>
            <button
              type="button"
              id="resultsLegendBtn"
              class="btn btn-sm btn-outline-secondary rounded-circle legend-help-btn"
              data-bs-toggle="popover"
              data-bs-placement="bottom"
              data-bs-html="true"
              data-bs-title="Legenda kolorów wierszy"
              data-bs-content="<div class='legend-popover-body'>
                <div class='legend-row'><span class='legend-swatch table-warning'></span><span>Konto <strong>wyłączone</strong> (aktywne, ale zablokowany login)</span></div>
                <div class='legend-row'><span class='legend-swatch table-danger'></span><span>Konto <strong>wyłączone i przeniesione</strong> do OU zablokowane_konta (soft delete)</span></div>
                <div class='legend-row'><span class='legend-swatch'></span><span>Brak koloru = konto aktywne</span></div>
              </div>"
            >?</button>
          </div>
          <div class="btn-group">
            <button class="btn btn-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">Dodaj</button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#newUserModal">Dodaj użytkownika</button></li>
              <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#newGroupModal">Dodaj grupę</button></li>
            </ul>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0" id="resultsTable">
              <thead>
              <tr>
                <th style="width:40px;">Typ</th>
                <th>Nazwa</th>
                <th>DN</th>
                <th style="width:230px;">Akcje</th>
              </tr>
              </thead>
              <tbody id="results"></tbody>
            </table>
          </div>
        </div>
      </section>
    </section>

    <section class="tab-pane fade" id="reports-panel" role="tabpanel" aria-labelledby="reports-tab">
      <section class="card mb-4">
        <div class="card-header">Lista raportów</div>
        <div class="card-body">
          <div class="list-group" id="reportsList">
            <button class="list-group-item list-group-item-action report-link active" data-report="stale-logons" type="button">
              Nieaktywne konta AD
            </button>
            <button class="list-group-item list-group-item-action report-link" data-report="portal-activity" type="button">
              Aktywność portalu
            </button>
            <button class="list-group-item list-group-item-action report-link" data-report="login-history" type="button">
              Historia logowań
            </button>
          </div>
        </div>
      </section>

      <section class="card report-page" data-report-page="stale-logons">
        <div class="card-header">Raport: nieaktywne konta AD</div>
        <div class="card-body">
          <div class="input-group mb-3" style="max-width: 320px;">
            <span class="input-group-text">Starsze niż</span>
            <input id="reportYears" type="number" class="form-control" value="2" min="1" />
            <span class="input-group-text">lata</span>
            <button class="btn btn-outline-primary" id="loadReportBtn">Generuj</button>
          </div>
          <div id="reportResult" class="small"></div>
        </div>
      </section>

      <section class="card mt-4 report-page d-none" data-report-page="portal-activity">
        <div class="card-header">Raport: aktywność portalu</div>
        <div class="card-body">
          <form id="portalActivityFilterForm" class="row g-2 mb-3">
            <div class="col-md-3">
              <input id="portalActivitySearch" class="form-control form-control-sm" placeholder="Szukaj: użytkownik, akcja, DN..." />
            </div>
            <div class="col-md-2">
              <input id="portalActivityFrom" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
              <input id="portalActivityTo" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
              <select id="portalActivityAction" class="form-select form-select-sm">
                <option value="">Wszystkie akcje</option>
              </select>
            </div>
            <div class="col-md-1">
              <select id="portalActivityStatus" class="form-select form-select-sm">
                <option value="">Status</option>
                <option value="success">success</option>
                <option value="error">error</option>
              </select>
            </div>
            <div class="col-md-1">
              <select id="portalActivityPageSize" class="form-select form-select-sm">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
              </select>
            </div>
            <div class="col-md-1 d-grid">
              <button class="btn btn-sm btn-primary" type="submit">Filtruj</button>
            </div>
          </form>
          <div id="portalActivityList" class="small text-muted">Ładowanie…</div>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <button id="portalActivityPrev" class="btn btn-sm btn-outline-secondary">← Poprzednia</button>
            <div id="portalActivityPaginationInfo" class="small text-muted">-</div>
            <button id="portalActivityNext" class="btn btn-sm btn-outline-secondary">Następna →</button>
          </div>
        </div>
      </section>

      <section class="card mt-4 report-page d-none" data-report-page="login-history">
        <div class="card-header">Raport: historia logowań</div>
        <div class="card-body">
          <div id="loginHistoryList" class="small text-muted">Ładowanie…</div>
        </div>
      </section>
    </section>
  </div>
  </main>
</div>

<%- include('modals/objectModal') %>
<%- include('modals/newUserModal') %>
<%- include('modals/newGroupModal') %>
<%- include('modals/ouPickerModal') %>
<%- include('modals/groupToolsModals') %>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="appToast" class="toast align-items-center text-bg-primary border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body" id="toastBody"></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/vendor/jspdf/jspdf.umd.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
