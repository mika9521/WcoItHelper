<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Logowanie - Portal Zarządzania AD</title>
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #111827 0%, #312e81 55%, #4f46e5 100%);
    }
    .login-card {
      border: none;
      border-radius: 1rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }
    .login-icon {
      width: 3rem;
      height: 3rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #4f46e5;
      border-radius: 0.75rem;
      background: rgba(79, 70, 229, 0.12);
      margin-bottom: 0.75rem;
    }
    .btn-primary {
      background-color: #4f46e5;
      border-color: #4f46e5;
    }
    .btn-primary:hover,
    .btn-primary:active {
      background-color: #4338ca !important;
      border-color: #4338ca !important;
    }
    .form-control:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.15);
    }
    a { color: #4f46e5; }
  </style>
</head>
<body class="d-flex align-items-center vh-100">
  <main class="container">
    <section class="card login-card mx-auto" style="max-width: 420px;">
      <div class="card-body p-4">
        <div class="text-center">
          <div class="login-icon">AD</div>
          <h1 class="h4 mb-1">Portal Zarządzania AD</h1>
          <p class="text-muted small mb-4">Zaloguj się poświadczeniami domenowymi</p>
        </div>
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="post" action="/login">
          <div class="mb-3">
            <label class="form-label">Login</label>
            <input class="form-control" name="login" required autofocus />
          </div>
          <div class="mb-3">
            <label class="form-label">Hasło</label>
            <input class="form-control" type="password" name="password" required />
          </div>
          <button class="btn btn-primary w-100">Zaloguj</button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
